{
  "name": "storage_skip",
  "description": "The standard opener without any Storage Container: checks the owner's rule that storage is limited and fills fast. Only the hub vault and the refinery's bins hold the stock, so ore and saved metal fill them and the crawler and mine stop (storage first full is its target).",
  "faction": "federation",
  "planet": "class_m",
  "landing": { "prefer": ["duranium_ore", "tritanium_ore"] },
  "survey": { "max_distance": 22 },
  "crawlers": { "prefer": ["duranium_ore", "tritanium_ore"], "max_distance": 12, "refuel": { "resource": "deuterium", "below": 60, "until": 200 } },
  "upkeep": { "maintain_below": 55, "repair_below": 45 },
  "research": ["improved_smelting", "ore_conveyors", "preventive_maintenance", "alloy_metallurgy", "reinforced_drills", "automated_maintenance", "deep_core_mining"],
  "pause": [
    { "building": "foundry", "when": "duranium < 100 or tritanium < 60 or parasteel >= 40", "resume": "duranium >= 180 and tritanium >= 100 and parasteel < 20" }
  ],
  "steps": [
    { "build": "refinery" },
    { "build": "mine", "deposit": ["tritanium_ore", "duranium_ore"], "timeout": 300 },
    { "build": "science_lab" },
    { "upgrade": "refinery" },
    { "build": "vehicle_bay" },
    { "unit": "mining_crawler" },
    { "build": "fusion_reactor" },
    { "build": "foundry" },
    { "upgrade": "colony_hub" },
    { "upgrade": "refinery", "when": "parasteel >= 20" }
  ]
}

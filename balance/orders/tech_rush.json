{
  "name": "tech_rush",
  "description": "Research first: beam the hold down, storage, refinery, a Research Lab straight away, a mine and a second lab, then refinery Mk II, the reactor and the foundry (paused while metal is short); works through every surface tech, cheapest economy boosts first.",
  "faction": "federation",
  "planet": "class_m",
  "landing": { "prefer": ["duranium_ore", "tritanium_ore"] },
  "survey": { "max_distance": 22 },
  "crawlers": { "prefer": ["duranium_ore", "tritanium_ore"], "max_distance": 12, "refuel": { "resource": "deuterium", "below": 60, "until": 200 } },
  "upkeep": { "maintain_below": 55, "repair_below": 45 },
  "research": ["improved_smelting", "preventive_maintenance", "ore_conveyors", "alloy_metallurgy", "automated_maintenance", "reinforced_drills", "deep_core_mining"],
  "pause": [
    { "building": "foundry", "when": "duranium < 100 or tritanium < 60 or parasteel >= 40", "resume": "duranium >= 180 and tritanium >= 100 and parasteel < 20" }
  ],
  "steps": [
    { "beam_supplies": true, "after": "hub_ready", "timeout": 120 },
    { "build": "storage_container" },
    { "beam_supplies": true, "timeout": 60 },
    { "build": "refinery" },
    { "build": "science_lab" },
    { "beam_supplies": true, "timeout": 60 },
    { "build": "mine", "deposit": "duranium_ore", "timeout": 240 },
    { "build": "science_lab" },
    { "upgrade": "refinery" },
    { "build": "fusion_reactor" },
    { "build": "foundry" },
    { "upgrade": "mine", "timeout": 600 }
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Makes sure nuget.org is a package source even on machines whose NuGet has none configured (the Godot.NET.Sdk
     package and the rest come from there). Adds to the machine's sources; it doesn't clear Godot's own local one. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
